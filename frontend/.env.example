# Base URL of the backend API.
# Public: VITE_ variables are embedded in the JavaScript sent to the browser,
# so never put secrets in this file.
VITE_API_URL=http://localhost:8000

# Largest video that can be uploaded, in megabytes. Keep it the same as
# MAX_UPLOAD_MB in the root .env: the form uses it to refuse a larger file
# before sending it.
VITE_MAX_UPLOAD_MB=500
