# Database
MYSQL_DATABASE=meeting_notes
MYSQL_USER=meeting_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Where the backend finds the database: localhost while the backend runs
# locally, db when the backend runs in Docker.
DB_HOST=localhost

# Port on the host machine. Change it if 3306 is already in use.
DB_PORT=3306

# Backend
# Origins that are allowed to call the API (CORS), separated by commas
CORS_ORIGINS=http://localhost:5173
