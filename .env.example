# Database
MYSQL_DATABASE=meeting_notes
MYSQL_USER=meeting_user
MYSQL_PASSWORD=change-me
# Also used by the backend tests to create their own database (<MYSQL_DATABASE>_test)
MYSQL_ROOT_PASSWORD=change-me-too

# Where the backend finds the database: localhost while the backend runs
# locally, db when the backend runs in Docker.
DB_HOST=localhost

# Port on the host machine. Change it if 3306 is already in use.
DB_PORT=3306

# Backend
# Origins that are allowed to call the API (CORS), separated by commas
CORS_ORIGINS=http://localhost:5173

# Lowest level of the log messages the backend prints:
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# true: the API documentation (Swagger) is at http://localhost:8000/docs.
# Set it to false (or leave it out) in production.
ENABLE_DOCS=true

# Folder for uploaded videos. A relative path is resolved from the backend/ folder.
UPLOAD_DIR=uploads

# Largest video that can be uploaded, in megabytes
MAX_UPLOAD_MB=500

# Longest time ffmpeg may take to extract the audio from one video, in seconds.
FFMPEG_TIMEOUT_SECONDS=600

# Gemini
# API key from https://aistudio.google.com/apikey. Keep the real key only in .env.
GEMINI_API_KEY=your-api-key-here

# Model used for the transcription and for the summary
GEMINI_MODEL=gemini-3.8-flash

# Longest time one request to Gemini may take, in seconds.
GEMINI_TIMEOUT_SECONDS=600

# Login
# Secret that signs the login tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the real secret only in .env. Changing it logs everyone out.
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters

# How long a login lasts, in hours
JWT_EXPIRE_HOURS=12

# Only addresses with this domain can register (for example example.com).
# Leave empty to allow any address.
ALLOWED_EMAIL_DOMAIN=

# The first admin, made with: python -m app.create_admin (from backend/)
# The password is used only when the account is created; after that the admin
# changes it in the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-characters
