# Database
MYSQL_DATABASE=meeting_notes
MYSQL_USER=meeting_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Where the backend finds the database: localhost while the backend runs
# locally, db when the backend runs in Docker.
DB_HOST=localhost

# Port on the host machine. Change it if 3306 is already in use.
DB_PORT=3306

# Backend
# Origins that are allowed to call the API (CORS), separated by commas
CORS_ORIGINS=http://localhost:5173

# Folder for uploaded videos. A relative path is resolved from the backend/ folder.
UPLOAD_DIR=uploads

# Largest video that can be uploaded, in megabytes
MAX_UPLOAD_MB=500

# Longest time ffmpeg may take to extract the audio from one video, in seconds.
FFMPEG_TIMEOUT_SECONDS=600

# Gemini
# API key from https://aistudio.google.com/apikey. Keep the real key only in .env.
GEMINI_API_KEY=your-api-key-here

# Model used for the transcription and for the summary
GEMINI_MODEL=gemini-3.8-flash
